{
  "name": "codex-reset-signal",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Monitor Tibo reset and bank announcements, extract event times, and notify bots in your timezone.",
  "license": "MIT",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "postbuild": "node scripts/prepare-dist.mjs",
    "start": "cross-env NODE_ENV=production vinext start",
    "monitor": "node --import tsx src/cli.ts",
    "monitor:dry": "node --import tsx src/cli.ts --dry-run",
    "monitor:loop": "node --import tsx src/cli.ts --loop",
    "webhook:debug": "node --import tsx src/webhook-debug.ts",
    "pages:validate": "node scripts/validate-pages.mjs",
    "cloudflare:dry-run": "npx --yes wrangler@4 deploy --dry-run --config wrangler.jsonc",
    "deploy:cloudflare": "npm run build && npx --yes wrangler@4 deploy --config wrangler.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrono-node": "^2.10.1",
    "luxon": "^3.7.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vinext": "^0.0.16"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "cross-env": "^10.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
